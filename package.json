{
    "name": "devguard-documentation",
    "version": "0.1.0",
    "description": "Devguard documentation",
    "scripts": {
        "dev": "next dev --webpack",
        "check:api-pages": "node utilities/check-api-reference-pages.mjs",
        "prebuild": "npm run check:api-pages",
        "build": "next build --webpack",
        "start": "next start",
        "postbuild": "next-sitemap && cp sitemap.xml public/sitemap.xml && node utilities/copy-pages-to-public.mjs && node utilities/create-llmstxt.mjs",
        "lint": "next lint",
        "postinstall": "patch-package",
        "seo-check": "docker run --rm -w /app -v $(pwd):/app registry.opencode.de/open-code/document-writing-tools/seo-check:main-amd64",
        "lychee": "lychee --config lychee.toml src/pages --root-dir $(pwd)/src/pages"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/l3montree-dev/devguard-documentation.git"
    },
    "author": {
        "name": "l3montree GmbH",
        "email": "developer@l3montree.com",
        "url": "https://l3montree.com/"
    },
    "contributors": [
        {
            "name": "Tim Bastin",
            "email": "tim.bastin@l3montree.com"
        },
        {
            "name": "Sebastian Kawelke",
            "email": "sebastian.kawelke@l3montree.com"
        }
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/l3montree-dev/devguard-documentation/issues"
    },
    "engines": {
        "node": ">=v26.10.0",
        "npm": ">=11.19.1"
    },
    "homepage": "https://github.com/l3montree-dev/devguard-documentation",
    "dependencies": {
        "@document-writing-tools/kernux-theme": "3.1.0",
        "@ltonetwork/http-message-signatures": "0.1.12",
        "@radix-ui/react-collapsible": "1.2.1",
        "@radix-ui/react-dialog": "1.3.1",
        "@radix-ui/react-separator": "1.2.0",
        "@radix-ui/react-slot": "1.5.0",
        "@radix-ui/react-tabs": "1.2.1",
        "@radix-ui/react-tooltip": "1.4.1",
        "@tanstack/react-table": "8.21.3",
        "@theguild/remark-mermaid": "0.3.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "date-fns": "4.4.0",
        "gray-matter": "4.0.3",
        "gsap": "3.15.0",
        "lodash": "4.18.1",
        "lucide-react": "1.61.0",
        "next": "16.4.3",
        "next-sitemap": "4.2.3",
        "ogl": "1.0.11",
        "openapi-types": "12.1.3",
        "patch-package": "^8.0.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-dropzone": "20.1.4",
        "react-markdown": "10.1.0",
        "recharts": "3.10.1",
        "sharp": "0.35.5",
        "swagger-ui-react": "5.34.0",
        "swr": "2.5.1",
        "tailwind-merge": "3.7.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "3.3.7",
        "@eslint/js": "10.0.1",
        "@tailwindcss/postcss": "4.3.3",
        "@types/lodash": "4.17.27",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/swagger-ui-react": "5.18.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "autoprefixer": "10.6.1",
        "eslint": "10.13.0",
        "eslint-config-next": "16.4.3",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.7",
        "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "overrides": {
        "sharp": "0.35.5",
        "postcss": "8.5.28",
        "js-yaml": "4.3.2",
        "sanitize-html": "2.17.7",
        "source-map-js": "1.2.2",
        "gray-matter": {
            "js-yaml": "^3.15.2"
        }
    }
}
